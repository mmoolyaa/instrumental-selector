# Server configuration — copy to .env and edit.
# Load with:  set -a; . ./.env; set +a

# Navidrome data directory (the one holding data/navidrome.db)
INSTR_LIB=/srv/data/navidrome

# Music root that media_file.path values are relative to (default: $INSTR_LIB/music)
# INSTR_MUSIC=/srv/data/navidrome/music

# Where finished instrumentals are cached
# INSTR_CACHE=./cache

# Delete cached MP3s older than this many hours (default 168 = 7 days)
# INSTR_TTL_HOURS=168

# Shared secret for writes and worker endpoints. Leave empty only on a trusted LAN.
# INSTR_TOKEN=

PORT=8899
