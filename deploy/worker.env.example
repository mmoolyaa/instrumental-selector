# Worker configuration — copy next to worker.py as worker.env (Windows) or export it (Unix).

# Where the server lives
INSTR_SERVER=http://127.0.0.1:8899

# Must match the server's INSTR_TOKEN if that is set
# INSTR_TOKEN=

# Separation model (any audio-separator model name)
# INSTR_MODEL=UVR-MDX-NET-Inst_HQ_3.onnx

# Model cache directory
# INSTR_MODELS=./models
